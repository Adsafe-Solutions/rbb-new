# Server settings for LOCAL review (npm run serve:local). NO SECRETS:
# every value here is a public, reserved demo value, and server/.env.local
# (git-ignored) is loaded after this file and overrides anything in it.
#
#   - Forms: EMAIL_MODE=test — every form really goes through the server
#     handler (validation, anti-spam, rate limit), and each email is
#     rendered to build-meta/email-previews/ instead of being sent.
#     Recipients are reserved example.org addresses.
#   - Donations: OFF here. To try the full checkout, put Razorpay TEST
#     credentials in server/.env.local (git-ignored):
#         DONATION_ENABLED=true
#         RAZORPAY_MODE=test
#         RAZORPAY_KEY_ID=rzp_test_…
#         RAZORPAY_KEY_SECRET=…
#         RAZORPAY_WEBHOOK_SECRET=…
#     The amount rules below then apply. Never live keys.
EMAIL_MODE=test
EMAIL_FROM=Rising Beyond Borders (local) <local@example.org>
EMAIL_TO_CONTACT=contact@example.org
EMAIL_TO_VOLUNTEER=volunteer@example.org
EMAIL_TO_PARTNER=partner@example.org
EMAIL_TO_FUNDRAISE=fundraise@example.org
EMAIL_TO_NEWSLETTER=newsletter@example.org
EMAIL_ACK_FORMS=contact,volunteer,partner,fundraise
NEWSLETTER_ENABLED=true
ALLOWED_ORIGIN=http://localhost:5190
RATE_LIMIT_MAX=20
RATE_LIMIT_WINDOW_S=600

DONATION_ENABLED=false
DONATION_CURRENCY=INR
DONATION_MIN_AMOUNT=100
DONATION_MAX_AMOUNT=100000
DONATION_ALLOWED_AMOUNTS=500,1000,2500,5000
DONATION_CUSTOM_AMOUNT=true
DONATION_EMAIL_ENABLED=true
EMAIL_TO_DONATIONS=donations@example.org
DONATION_DONOR_EMAILS=success,processing,failed,refunded
