# Copy to .env.local and fill in. Vite reads .env.development for `npm run dev`,
# .env.production for production builds, and .env.local in every mode —
# see https://vite.dev/guide/env-and-mode.
#
# Only VITE_* keys reach the browser. Anything secret must NOT carry the
# prefix, and nothing in this file is secret today.

# dev | prod. Descriptive only; nothing branches on it yet.
VITE_ENVIRONMENT=dev

# Canonical origin for this deployment, for absolute links and meta tags.
VITE_SITE_URL=http://localhost:5173

# Feature switches. Unset means "use the default in src/config/sections.js",
# so an environment only has to name what it wants different.
#   VITE_DESIGN_SYSTEM_ROUTE  true | false   (defaults to on in dev only)
#   VITE_COMPONENTS_ROUTE     true | false   (defaults to on in dev only)
VITE_DESIGN_SYSTEM_ROUTE=
VITE_COMPONENTS_ROUTE=
