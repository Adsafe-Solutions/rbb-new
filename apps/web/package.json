{
  "name": "@rbb/web",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/published-snapshot.mjs && vite build && vite build --ssr src/entry-server.jsx --outDir dist-ssr && NODE_ENV=production node scripts/prerender.mjs",
    "build:dev": "vite build --mode development",
    "build:prod": "node scripts/published-snapshot.mjs && vite build --mode production && vite build --mode production --ssr src/entry-server.jsx --outDir dist-ssr && NODE_ENV=production node scripts/prerender.mjs",
    "preview": "vite preview",
    "preview:cms": "node scripts/cms-preview.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "build:client": "vite build",
    "validate:content": "RBB_KEEP_DRAFTS=1 vite build --ssr src/entry-server.jsx --outDir build-meta/.validate --logLevel error && node scripts/validate-content.mjs",
    "test:server": "node --test \"server/test/*.test.mjs\"",
    "test:release": "node --test \"scripts/test/*.test.mjs\"",
    "release:status": "node scripts/release-status.mjs",
    "release:check": "node scripts/release-check.mjs",
    "smoke": "node scripts/smoke-test.mjs",
    "smoke:forms": "npx -y -p playwright -p axe-core node scripts/smoke-forms.mjs",
    "release:package": "node scripts/package-release.mjs",
    "serve:local": "node --env-file-if-exists=server/local.env --env-file-if-exists=server/.env.local server/dev-server.mjs",
    "deploy:pages": "node --env-file-if-exists=.env.deploy.local scripts/deploy-pages.mjs",
    "deploy:pages:check": "node --env-file-if-exists=.env.deploy.local scripts/deploy-pages.mjs --check"
  },
  "dependencies": {
    "@rbb/forms": "workspace:*",
    "gsap": "^3.15.0",
    "lenis": "^1.3.26",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.3"
  },
  "devDependencies": {
    "@rbb/content-schema": "workspace:*",
    "@tailwindcss/vite": "^4.1.18",
    "@vitejs/plugin-react": "^5.2.0",
    "prettier": "3.9.6",
    "tailwindcss": "^4.1.18",
    "vite": "^7.3.6",
    "wrangler": "4.149.0"
  }
}
