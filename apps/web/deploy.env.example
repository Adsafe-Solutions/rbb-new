# Copy to apps/web/.env.deploy.local (git-ignored) for `pnpm deploy:web`,
# or export the same variables in your shell. NAMES ONLY here — no value
# in this file is real, and the deployment script never prints a value.
# docs/DEPLOY_CLOUDFLARE_PAGES.md explains each one.

# The production build configuration. deploy:web refuses anything else.
RBB_SNAPSHOT_URL=https://api.risingbeyondborders.org/api/v1/public/snapshot
RBB_SNAPSHOT_REQUIRED=1
RBB_SNAPSHOT_RUNTIME=on

# Cloudflare authentication — ONE of:
#   (a) a `wrangler login` session (pnpm --filter @rbb/web exec wrangler login):
#       leave both lines below empty;
#   (b) an API token with "Cloudflare Pages: Edit" on the account, plus the
#       account id, from the Cloudflare dashboard. Never commit them.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
