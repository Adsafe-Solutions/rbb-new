{
  "name": "rbb-platform",
  "private": true,
  "packageManager": "pnpm@9.15.2",
  "scripts": {
    "build": "pnpm --filter @rbb/web run build",
    "web:dev": "pnpm --filter @rbb/web run dev",
    "web:build": "pnpm --filter @rbb/web run build",
    "web:preview": "pnpm --filter @rbb/web run preview",
    "web:test": "pnpm --filter @rbb/web run test:server && pnpm --filter @rbb/web run test:release",
    "web:validate": "pnpm --filter @rbb/web run validate:content",
    "web:release": "pnpm --filter @rbb/web run release:check",
    "web:release:status": "pnpm --filter @rbb/web run release:status",
    "web:release:package": "pnpm --filter @rbb/web run release:package",
    "web:smoke": "pnpm --filter @rbb/web run smoke",
    "web:serve": "pnpm --filter @rbb/web run serve:local",
    "admin:dev": "pnpm --filter @rbb/admin run dev",
    "admin:build": "pnpm --filter @rbb/admin run build",
    "admin:typecheck": "pnpm --filter @rbb/admin run typecheck",
    "admin:preview": "pnpm --filter @rbb/admin run preview",
    "api:dev": "pnpm --filter @rbb/api run dev",
    "api:build": "pnpm --filter @rbb/api run build",
    "api:start": "pnpm --filter @rbb/api run start",
    "api:typecheck": "pnpm --filter @rbb/api run typecheck",
    "api:test": "pnpm --filter @rbb/api run test",
    "schema:test": "pnpm --filter @rbb/content-schema run test",
    "schema:typecheck": "pnpm --filter @rbb/content-schema run typecheck",
    "typecheck": "pnpm run schema:typecheck && pnpm run admin:typecheck && pnpm run api:typecheck"
  }
}
