# Server-side configuration for apps/api — PLACEHOLDERS ONLY.
# Never put a real value in this file: it is committed.
#
# Local development: copy to apps/api/.env.local (git-ignored by *.local)
# and fill in there. On Vercel: set these in the project's Environment
# Variables. Full reference: apps/api/README.md.

# development | test | production (default development). Production refuses
# to start without ORGANIZATION_ID, MONGODB_URI and MONGODB_DB.
NODE_ENV=development

# The organization this deployment serves — the orgId of every record.
# Defaults to "rbb" outside production only.
ORGANIZATION_ID=

# SECRET. MongoDB connection string (mongodb:// or mongodb+srv://).
MONGODB_URI=
# The database name. Required whenever MONGODB_URI is set. RBB's is
# risingbeyondborders. (Integration tests use their own database,
# risingbeyondborders_test, through MONGODB_TEST_URI / MONGODB_TEST_DB —
# never this one. See README "MongoDB" and "Tests".)
MONGODB_DB=

# Browser origins allowed by CORS and the CSRF check (exact origins, https in
# production). RBB's production admin is https://admin.risingbeyondborders.org
# (also the only production origin on the R2 bucket's CORS rule — see
# docs/MEDIA_LIBRARY.md). Locally: ADMIN_ORIGIN=http://localhost:5174
WEB_ORIGIN=
ADMIN_ORIGIN=

# SECRET. 32+ characters, e.g. `openssl rand -hex 32`. Keys the hashes of
# IP addresses and login-throttle keys. Required in production.
AUTH_SECRET=
# Session cookie (defaults: cms_session, strict, 168 hours = 7 days).
AUTH_COOKIE_NAME=
AUTH_COOKIE_SAMESITE=
AUTH_SESSION_TTL_HOURS=

# SECRET. Givebutter API key (Dashboard → Settings → API keys). Server-side
# only — never a VITE_ variable. Unset: the donation provider is "not
# configured" and its routes answer 503.
GIVEBUTTER_API_KEY=

# Media storage — Cloudflare R2 (docs/MEDIA_LIBRARY.md). All of the first
# five, or none: unset, the media routes answer 503.
# The R2 API token behind the key pair needs "Object Read & Write" on
# R2_BUCKET, and the bucket's CORS must allow PUT from the admin's origin.
R2_ACCOUNT_ID=
R2_BUCKET=
# SECRET (both). Server-side only — never a VITE_ variable.
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# The bucket's PUBLIC origin (custom domain), https. Never the S3 endpoint.
R2_PUBLIC_URL=
# Optional: the S3 endpoint. Default https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com
R2_S3_API=

# SECRET. Optional build hook (Cloudflare Pages / Vercel) POSTed after each
# publish so the public site rebuilds from the new snapshot. Unset: publishing
# still works; the site picks the snapshot up at its next build.
DEPLOY_HOOK_URL=

# SECRET (32+ letters, digits, '-' or '_'). Turns scheduled publishing on (M15):
# a cron calls GET /api/v1/internal/scheduler/run with
# "Authorization: Bearer <CRON_SECRET>" (Vercel Cron sends it itself), or runs
# `pnpm api:scheduler:run`. Unset: the scheduler route answers 503 and
# scheduled publications wait for an owner's publish.
CRON_SECRET=

# M18 — the website's forms (POST /api/v1/forms/:formId). Email only. With
# EMAIL_MODE unset/off no form takes submissions. test = render, send
# nothing; staging = everything to EMAIL_TEST_RECIPIENT with [TEST] subjects;
# live = as addressed (needs a key and a From on a verified domain; a
# resend.dev From is refused). Locally: EMAIL_MODE=test,
# WEB_ORIGIN=http://localhost:5173 and an EMAIL_TO_<FORM> per form to try.
EMAIL_MODE=
# SECRET. Resend sending key restricted to the verified domain
# (RESEND_API_KEY is accepted as an alias).
EMAIL_API_KEY=
EMAIL_FROM=
# RBB's approved inbox per form; unset = that form stays off.
EMAIL_TO_CONTACT=
EMAIL_TO_VOLUNTEER=
EMAIL_TO_PARTNER=
EMAIL_TO_FUNDRAISE=
# Forms that email the submitter an acknowledgement (comma list).
EMAIL_ACK_FORMS=
# staging only.
EMAIL_TEST_RECIPIENT=
# Per client and form, per window (defaults 5 per 600 s).
FORMS_RATE_LIMIT_MAX=
FORMS_RATE_LIMIT_WINDOW_S=

# debug | info | warn | error (default info)
LOG_LEVEL=info

# Local dev server port (src/server.ts). Not used on Vercel.
PORT=4000

# Owner bootstrap command only (pnpm api:auth:bootstrap -- --confirm).
# Leave the password out to be prompted for it instead.
BOOTSTRAP_OWNER_EMAIL=
BOOTSTRAP_OWNER_NAME=
# BOOTSTRAP_OWNER_PASSWORD=
