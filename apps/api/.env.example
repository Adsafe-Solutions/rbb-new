# Server-side configuration for apps/api — PLACEHOLDERS ONLY.
# Never put a real value in this file: it is committed.
#
# Local development: copy to apps/api/.env.local (git-ignored by *.local)
# and fill in there. On Vercel: set these in the project's Environment
# Variables. Full reference: apps/api/README.md.

# development | test | production (default development). Production refuses
# to start without ORGANIZATION_ID, MONGODB_URI and MONGODB_DB.
NODE_ENV=development

# The organization this deployment serves — the orgId of every record.
# Defaults to "rbb" outside production only.
ORGANIZATION_ID=

# SECRET. MongoDB connection string (mongodb:// or mongodb+srv://).
MONGODB_URI=
# The database name. Required whenever MONGODB_URI is set.
MONGODB_DB=

# Browser origins allowed by CORS (exact origins, https in production).
WEB_ORIGIN=
ADMIN_ORIGIN=

# debug | info | warn | error (default info)
LOG_LEVEL=info

# Local dev server port (src/server.ts). Not used on Vercel.
PORT=4000
