# Server-side configuration for the form endpoint (Document 21).
# These are NOT Vite variables — none carries the VITE_ prefix, none is ever
# bundled for the browser. Set them in the hosting platform's secret /
# environment settings for the serverless function, never in a committed file.
# Full reference: server/config.mjs and docs/FORMS_AND_EMAIL.md.

# off | test | staging | live   (default off)
EMAIL_MODE=off

# SECRET. A new Resend API key (sending access, restricted to the verified
# domain). The key shared during planning is compromised — revoke it.
EMAIL_API_KEY=

# The approved sender on the verified domain, e.g. Name <forms@domain>.
EMAIL_FROM=

# Approved RBB recipients, one address each.
EMAIL_TO_CONTACT=
EMAIL_TO_VOLUNTEER=
EMAIL_TO_PARTNER=
EMAIL_TO_TRAVEL=
EMAIL_TO_FUNDRAISE=
EMAIL_TO_NEWSLETTER=

# Forms that email the submitter an acknowledgement, e.g. contact,volunteer
EMAIL_ACK_FORMS=

# true only once consent wording, unsubscribe and subscriber management exist.
NEWSLETTER_ENABLED=false

# staging only: the single inbox that receives everything.
EMAIL_TEST_RECIPIENT=

# The site's own origin, e.g. https://www.domain — other origins are refused.
ALLOWED_ORIGIN=

# Per client and form, within the window (seconds).
RATE_LIMIT_MAX=5
RATE_LIMIT_WINDOW_S=600

# How requests are counted (Document 25). "memory" (default) or "shared".
# "shared": the host adapter passes its own limiter (platform rate limiting
# or a shared store) — required on serverless / multi-instance hosts.
# In LIVE mode an in-memory limiter is refused unless this is ONE
# long-lived process and RATE_LIMIT_SINGLE_INSTANCE=true says so.
RATE_LIMIT_STORE=memory
RATE_LIMIT_SINGLE_INSTANCE=false
