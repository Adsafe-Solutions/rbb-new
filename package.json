{
  "name": "rbb",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && vite build --ssr src/entry-server.jsx --outDir dist-ssr && NODE_ENV=production node scripts/prerender.mjs",
    "build:dev": "vite build --mode development",
    "build:prod": "vite build --mode production && vite build --mode production --ssr src/entry-server.jsx --outDir dist-ssr && NODE_ENV=production node scripts/prerender.mjs",
    "preview": "vite preview",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "build:client": "vite build",
    "validate:content": "RBB_KEEP_DRAFTS=1 vite build --ssr src/entry-server.jsx --outDir build-meta/.validate --logLevel error && node scripts/validate-content.mjs",
    "test:server": "node --test \"server/test/*.test.mjs\"",
    "test:release": "node --test \"scripts/test/*.test.mjs\"",
    "release:status": "node scripts/release-status.mjs",
    "release:check": "node scripts/release-check.mjs",
    "smoke": "node scripts/smoke-test.mjs",
    "release:package": "node scripts/package-release.mjs",
    "serve:local": "node --env-file-if-exists=server/local.env --env-file-if-exists=server/.env.local server/dev-server.mjs",
    "check:razorpay": "node scripts/check-razorpay-checkout.mjs"
  },
  "dependencies": {
    "gsap": "^3.15.0",
    "lenis": "^1.3.26",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.3"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.18",
    "@vitejs/plugin-react": "^5.2.0",
    "prettier": "3.9.6",
    "tailwindcss": "^4.1.18",
    "vite": "^7.3.6"
  }
}
