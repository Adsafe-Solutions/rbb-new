{
  "name": "@rbb/api",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env.local --watch src/server.ts",
    "build": "pnpm run typecheck && esbuild src/vercel.ts src/server.ts src/scripts/ensure-indexes.ts --bundle --platform=node --target=node22 --format=esm --outbase=src --outdir=dist --external:mongodb --log-level=warning",
    "start": "node --env-file-if-exists=.env.local dist/server.js",
    "typecheck": "tsc -p tsconfig.json",
    "test": "node --test \"test/*.test.ts\"",
    "test:integration": "node --test --test-concurrency=1 \"test/integration/*.test.ts\"",
    "db:indexes": "node --env-file-if-exists=.env.local dist/scripts/ensure-indexes.js"
  },
  "dependencies": {
    "@rbb/content-schema": "workspace:*",
    "mongodb": "^7.7.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "esbuild": "0.28.2",
    "typescript": "^7.0.2"
  }
}
