# Copy to .env.local and fill in. Vite reads .env.development for `npm run dev`,
# .env.production for production builds, and .env.local in every mode —
# see https://vite.dev/guide/env-and-mode.
#
# Only VITE_* keys reach the browser. Anything secret must NOT carry the
# prefix, and nothing in this file is secret today.

# dev | preview | prod. Optional measurement (analytics, monitoring —
# none approved, see src/config/observability.js) can only ever run in a
# production build with VITE_ENVIRONMENT=prod AND a verified VITE_SITE_URL.
# Preview deployments: set "preview", so they can never send data.
VITE_ENVIRONMENT=dev

# The site's production origin, e.g. https://www.<domain> — for canonical
# tags, social metadata, structured data and sitemap.xml (Document 14).
# Leave EMPTY until RBB confirms the domain. Only an https origin on a real
# host is accepted (src/config/env.js); localhost, example.com and other
# reserved names are ignored, and with no origin the site simply omits
# every absolute URL rather than publishing a guessed one.
VITE_SITE_URL=

# Feature switches. Unset means "use the default in src/config/sections.js",
# so an environment only has to name what it wants different.
#   VITE_DESIGN_SYSTEM_ROUTE  true | false   (defaults to on in dev only)
#   VITE_COMPONENTS_ROUTE     true | false   (defaults to on in dev only)
VITE_DESIGN_SYSTEM_ROUTE=
VITE_COMPONENTS_ROUTE=

# Where the donation page calls RBB's donation endpoints (Document 22),
# normally the same-origin path /api/donations. PUBLIC — it is compiled into
# the bundle. Every Razorpay key and secret, the currency and the amounts
# are SERVER settings (server/env.example), never VITE_* variables. Unset:
# the build contains no checkout code at all. Set, the checkout still shows
# only once content/donation.js approves it and the Privacy Policy is
# published (docs/DONATIONS.md).
VITE_DONATIONS_API=
