VITE_ENVIRONMENT=prod
# Production origin — EMPTY until RBB confirms the domain (see .env.example).
VITE_SITE_URL=
VITE_DESIGN_SYSTEM_ROUTE=
VITE_COMPONENTS_ROUTE=

# The colour-theme switcher (bottom-left), true | false — off unless set.
# The Poster and Midnight themes are built (src/styles/index.css); this
# only decides whether visitors can choose one.
VITE_THEME_SWITCHER=true
